flowchart TD
    A(["INÍCIO: Navegador faz requisição"]) 
    
    A --> B["Navegador envia request para Gateway"]
    
    B --> C{"É preflight<br/>CORS?"}
    C -->|Sim| D["Gateway responde OK<br/>com headers CORS"]
    D --> A
    C -->|Não| E["Request com token JWT<br/>no header Authorization"]
    
    E --> F["Gateway recebe request"]
    
    F --> G["Validar JWT<br/>assinatura, validade"]
    
    G --> H{"JWT<br/>válido?"}
    
    H -->|Não| I["Retorna 401<br/>para navegador"]
    I --> A
    
    H -->|Sim| J["Extrai informações do JWT<br/>usuário, roles, scopes"]
    
    J --> K["Adiciona headers secretos:<br/>X-Gateway-Secret<br/>X-User-Id"]
    
    K --> L["Encaminha request<br/>para backend aura-api"]
    
    L --> M["Backend recebe request"]
    
    M --> N["Filter verifica<br/>X-Gateway-Secret"]
    
    N --> O{"Secret<br/>correto?"}
    
    O -->|Não| P["Retorna 403<br/>para gateway"]
    P --> L
    
    O -->|Sim| Q["Executa lógica do negócio<br/>Controller → Service → BD"]
    
    Q --> R["Retorna resposta<br/>200 OK com dados"]
    
    R --> S["Gateway encaminha<br/>resposta ao navegador"]
    
    S --> T(["FIM: Navegador recebe resposta"])
    
