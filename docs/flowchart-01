flowchart TD

    %% =========================
    %% ENTRADA
    %% =========================

    A[Mensagem recebida via WhatsApp] --> B[Webhook n8n]
    B --> C[Normalização da mensagem]

    %% =========================
    %% IDENTIFICAÇÃO DO CLIENTE
    %% =========================

    C --> D{Cliente já existe?}

    D -->|Sim| E[Buscar histórico resumido]
    D -->|Não| F[Criar perfil do cliente]

    E --> G[Carregar memória curta]
    F --> G

    %% =========================
    %% SEGURANÇA
    %% =========================

    G --> H[Agente de Segurança]

    H --> I{Mensagem permitida?}

    I -->|Não| J[Responder mensagem de bloqueio]
    J --> Z[Fim]

    I -->|Sim| K[Classificador de Intenção]

    %% =========================
    %% CLASSIFICAÇÃO
    %% =========================

    K --> L{Objetivo da conversa}

    L -->|Horários| M[Agente Horários]
    L -->|Serviços| N[Agente Serviços]
    L -->|Valores| O[Agente Valores]
    L -->|Agendamento| P[Agente Agendamento]
    L -->|Cancelamento| Q[Agente Cancelamento]
    L -->|Reagendamento| S[Agente Reagendamento]
    L -->|Fora do Escopo| R[Agente Restrição]

    %% =========================
    %% AGENTES ESPECIALIZADOS
    %% =========================

    M --> T[Gerar resposta]
    N --> T
    O --> T
    P --> U[Consultar agenda]
    Q --> V[Consultar agendamento]
    S --> X[Consultar agendamento e nova disponibilidade]
    R --> W[Mensagem de escopo]

    U --> T
    V --> T
    X --> T

    %% =========================
    %% REDUÇÃO DE TOKENS
    %% =========================

    T --> Y[Resumidor de contexto]
    W --> Y

    %% =========================
    %% MEMÓRIA
    %% =========================

    Y --> AA[Salvar memória resumida]

    %% =========================
    %% OBSERVABILIDADE
    %% =========================

    AA --> AB[Salvar logs]
    AB --> AC[Métricas e monitoramento]

    %% =========================
    %% RESPOSTA
    %% =========================

    AC --> AD[Enviar resposta WhatsApp]
    AD --> Z[Fim]

    %% =========================
    %% ESTILOS
    %% =========================

    classDef security fill:#ffdddd,stroke:#ff0000,color:#000;
    classDef agent fill:#ddeeff,stroke:#0077cc,color:#000;
    classDef memory fill:#fff2cc,stroke:#d6b656,color:#000;
    classDef system fill:#e2f0d9,stroke:#70ad47,color:#000;

    class H,I,J security;
    class M,N,O,P,Q,R,S,T,U,V,W,X agent;
    class E,G,Y,AA memory;
    class A,B,C,AB,AC,AD system;
